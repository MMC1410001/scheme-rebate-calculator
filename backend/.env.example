# Scheme Performance & Impact Calculator -- backend settings.
# The API reads backend/.env.<APP_ENV> (APP_ENV=local by default; dev, uat, prod on servers).
# Environment variables always win over this file. Copy to .env.local, .env.dev, .env.uat or .env.prod.

# Which settings file this is: local | dev | uat | prod.
APP_ENV=local

# --- App ---
# "all" exposes every scheme (unreconciled ones flagged); "verified" only those that reconcile.
SCHEME_MODE=all
# Pin the live month to a registered label (e.g. 2026-09-d25) instead of the newest synced GCS file.
# Empty: the newest synced GCS file.
LIVE_MONTH=

# --- GCS input (read-only) ---
GCS_BUCKET=example-scheme-files
# Optional Google Cloud project for the GCS client; empty uses the service account's own project.
GCS_PROJECT=
# Service-account key with storage.objectViewer on the bucket, as base64 of the key's JSON file on
# one line (macOS: base64 -i key.json; Linux: base64 -w0 key.json). A read-only service account.
# Never commit a real key: set it in .env.<APP_ENV>, which git ignores.
GCS_CREDENTIALS_JSON=<base64 of the service-account key JSON>
# Alternative to GCS_CREDENTIALS_JSON: path to the key file. Empty: the server's own service account.
GOOGLE_APPLICATION_CREDENTIALS=
# One month's folder. Only files directly in it are read, never daily/ (not every extract is copied there).
GCS_PREFIX_TEMPLATE=scheme-extracts/output/{year}/{month:02d}/
# Only the no-condonation file of each pair is read; the highest version wins (upload date is the extract date).
GCS_FILE_PATTERN=_v(?P<version>\d+)_no_condonation\.xlsx$
# Read daily files from this local folder (same layout as the bucket) instead of GCS. Development only.
LOCAL_DATA_DIR=
# Where synced files and their parquet caches are kept. Empty: backend/data/gcs.
DATA_DIR=
# "Today" for the loader is a day in this timezone.
TIMEZONE=Asia/Kolkata

# --- Daily loader (in Docker: the loader container, docker-compose.yml, which sets this itself;
#     elsewhere it runs inside the API; no separate cron job) ---
# Empty: on everywhere except APP_ENV=local. false where an external cron runs
# `python -m app.ingest.gcs_sync` instead.
LOADER_SCHEDULE_ENABLED=
# Daily run time, HH:MM in TIMEZONE. The daily files land around 13:00-13:15 India time.
LOADER_DAILY_AT=14:00
# A failed run is tried again this many times, this many minutes apart.
LOADER_RETRIES=3
LOADER_RETRY_MINUTES=30
# A run taking longer is stopped and counts as failed.
LOADER_TIMEOUT_MINUTES=60
# In the first days of a month the previous month is synced too: its final files arrive in the first
# days of the next month (September's were dated 1, 3 and 4 October).
LOADER_CATCH_UP_DAYS=10
# Months of data kept, the current one included (current + last 3): synced files on disk and the
# Postgres data store. GCS keeps every file. 0 keeps all.
LOADER_RETENTION_MONTHS=4
# Saved versions (what-ifs saved from the Simulator): months of versions kept, the live month included. 3 keeps
# the live month and the two before it (Nov live: Sep, Oct, Nov); versions saved in an older month are deleted,
# saved or archived. 0 keeps all. SCENARIO_RETENTION_MONTHS, the earlier name, is still read.
VERSION_RETENTION_MONTHS=3

# Web app origins allowed to call the API (CORS), comma-separated, e.g. https://dev.example.com. Not needed
# when the web app reaches the API through /api (nginx in Docker, Vite in dev): that is the same address.
# Empty: only the local Vite dev server (http://localhost:5173, http://127.0.0.1:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The data store: schema spi (backend/db/scheme_performance_calculator/README.md). Any existing
# Postgres database works (DevOps need not create one): the tables go in schema spi only.
# SPI_DATABASE_URL is the API's login (reads and writes data); SPI_OWNER_URL runs migrations (python -m app.spi.migrate,
# also at container start when it is set) and loads (python -m app.spi.load, after each daily sync). One login can be
# both: then it owns schema spi. Empty: no database (the API runs from the files; versions cannot be saved).
SPI_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<existing database>
SPI_OWNER_URL=postgresql://<user>:<password>@<host>:<port>/<existing database>
# Where month data comes from: files (default) or spi (the new database; a month it does not hold is read from files).
DATA_SOURCE=files
# Login (app/auth.py, as in an earlier internal app). The built-in administrator (role ADMIN): ADMIN_USERNAME and
# ADMIN_PASSWORD. More users go in ADMIN_USERS, one JSON object on one line:
#   {"<username>": {"role": "ADMIN" | "VIEWER", "password": "<hash>"}, ...}
# `python -m app.auth_user <username> [ADMIN|VIEWER]` (from backend/) prints a random password and the entry to add.
# VIEWER: every view and the simulator, but no dealer lists (dealer names) and no saving / archiving versions.
# ADMIN_SESSION_SECRET signs the login cookie: at least 32 random characters; changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every environment except local needs a user and the secret (else every business route answers 503).
# ADMIN_PASSWORD may be the password itself only on local and dev; uat and prod need its hash
# (`python -m app.auth_user admin ADMIN` prints a password and its hash; put the hash here).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<a long random password>
ADMIN_USERS={"vera": {"role": "VIEWER", "password": "pbkdf2-sha256:600000:<salt>:<hash>"}}
ADMIN_SESSION_SECRET=<at least 32 random characters>
# The login cookie only over HTTPS. Empty: on everywhere except APP_ENV=local; false only for plain http.
SESSION_COOKIE_SECURE=
# Proxies whose X-Forwarded-For the login limit believes (comma-separated IPs or host names). Empty: this
# machine and the web container (scheme-performance-web); any other caller is limited by its own address.
TRUSTED_PROXIES=
# Used by the web app BUILD, not by the API: the API address the browser calls (npm run build).
# /api/v1 (normal, keep it set): the API on the web app's own address; nginx (Docker) and Vite (npm run dev) forward it to the
# API. Otherwise the full base, version included (e.g. https://api.example.com/v1).
VITE_API_BASE_URL=/api/v1
