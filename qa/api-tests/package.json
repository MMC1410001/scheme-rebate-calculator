{
  "name": "scheme-performance-calculator-qa",
  "private": true,
  "description": "Playwright API and browser test suites for the Scheme Performance & Impact Calculator",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api.spec.js",
    "test:common": "playwright test tests/common.spec.js",
    "test:functional": "playwright test --grep @functional",
    "test:validation": "playwright test --grep @validation",
    "test:edge": "playwright test --grep @edge",
    "test:negative": "playwright test --grep @negative",
    "test:security": "playwright test --grep @security",
    "report": "playwright show-report",
    "test:ui": "playwright test -c playwright.ui.config.js",
    "report:ui": "playwright show-report playwright-report-ui"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
